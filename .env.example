# cirrus integration test configuration
#
# Copy this file to `.env` (gitignored) and fill in the values. Or set
# the same vars in your shell — shell takes precedence.
#
# Shared by three integration suites:
#   * cirrus              (REST client)
#   * cirrus-auth         (OAuth flows)
#   * cirrus-metadata     (SOAP Metadata API)
#
# All three honor the same env vars and the same URL safety guard, so
# one .env configures the whole workspace. Run each suite with:
#   cargo nextest run -p <crate> --run-ignored only \
#       -E 'binary(integration)' -j 1
#
# Tests are gated behind a URL-pattern safety check that refuses to run
# on production My Domains. See each crate's tests/integration/common.rs
# for the full contract and override flag.
#
# Once CIRRUS_INTEGRATION=1 is set, an incomplete auth configuration
# fails the run rather than skipping — a blank `KEY=` counts as unset.

# 1 = enable integration tests at all. Anything else (or unset) skips.
CIRRUS_INTEGRATION=1

# Org instance URL. MUST match a known sandbox/dev/scratch pattern:
#   *.sandbox.my.salesforce.com      — sandbox
#   *.develop.my.salesforce.com      — Trailhead Playground / newer dev orgs
#   *.scratch.my.salesforce.com      — scratch org (sfdx)
#   *.trailblaze.my.salesforce.com   — free Dev Edition org from
#                                      developer.salesforce.com signup
# Anything else requires CIRRUS_INTEGRATION_FORCE=1 (see below).
CIRRUS_INTEGRATION_INSTANCE_URL=https://your-org.develop.my.salesforce.com

# ─── Path A: static token (easy bootstrap) ───
# Get one via:  sf org display --target-org your-alias
# Tokens expire in ~2h; refresh manually as needed.
# CIRRUS_INTEGRATION_ACCESS_TOKEN=00D...!AQ...

# ─── Path B: JWT bearer flow (full auth-flow exercise) ───
# Requires a connected app on the target org with "Use digital
# signatures" enabled and the certificate's private key locally.
# https://help.salesforce.com/s/articleView?id=xcloud.remoteaccess_oauth_jwt_flow.htm
# CIRRUS_INTEGRATION_USERNAME=test-7emx29@example.com
# CIRRUS_INTEGRATION_CONSUMER_KEY=3MVG9...
#
# Private key path. Nothing expands `~` — it is read as a literal
# directory name — so give an absolute path.
# CIRRUS_INTEGRATION_PRIVATE_KEY_PATH=/home/you/.cirrus/test-private.pem
#
# Authorization host, https only. `https://login.salesforce.com` is the
# default and the right value for the `.develop.` / `.trailblaze.` org
# shown above. For a sandbox or scratch org, use that org's My Domain
# login URL instead — e.g. https://mycompany--uat.sandbox.my.salesforce.com
# SOURCE: https://developer.salesforce.com/docs/atlas.en-us.sfdx_dev.meta/sfdx_dev/sfdx_dev_auth_jwt_flow.htm
# CIRRUS_INTEGRATION_LOGIN_URL=https://login.salesforce.com

# ─── Production-domain bypass ───
# Set ONLY when you've verified the target org is safe for destructive
# writes despite the URL pattern not matching the safe-list above.
# CIRRUS_INTEGRATION_FORCE=1
